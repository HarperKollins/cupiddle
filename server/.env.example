# Cupiddle Production Environment Configuration

# Server listen port
PORT=8080

# Runtime Environment (development, staging, production)
ENVIRONMENT=production

# Database Connection:
# For Neon Serverless PostgreSQL:
# 1. Sign up / login at https://neon.tech
# 2. Create a project named "cuppidle"
# 3. Copy the pooled connection string with sslmode=require:
DATABASE_URL=postgres://username:password@ep-silent-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Explicit Database Driver (auto-detected as 'postgres' when DATABASE_URL has postgres://)
DB_DRIVER=postgres

# Secret key for signing production JWT tokens (Use a secure 64-char random string)
JWTSecret=cupiddle-prod-jwt-secret-replace-with-secure-random-token-2026

# Directory for file uploads (photos, audio rants)
STORAGE_PATH=./uploads

# In-memory sliding window rate limit (requests per minute)
RATE_LIMIT_REQ=240
